<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="350.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReservaController">

    <children>
        <Label layoutX="190.0" layoutY="30.0" text="CRIAR RESERVA" />

        <Label layoutX="80.0" layoutY="80.0" text="Quarto:" />
        <Label fx:id="labelQuarto" layoutX="150.0" layoutY="80.0" text="-" />

        <Label layoutX="80.0" layoutY="120.0" text="Nome:" />
        <TextField fx:id="campoNome" layoutX="150.0" layoutY="115.0" prefWidth="230.0" />

        <Label layoutX="80.0" layoutY="160.0" text="CPF:" />
        <TextField fx:id="campoCpf" layoutX="150.0" layoutY="155.0" prefWidth="230.0" />

        <Button layoutX="150.0" layoutY="220.0" text="Reservar" onAction="#reservar" />
        <Button layoutX="270.0" layoutY="220.0" text="Cancelar" onAction="#cancelar" />
    </children>
</AnchorPane>