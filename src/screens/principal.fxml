<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PrincipalController">

    <children>
        <Label layoutX="290.0" layoutY="25.0" text="HOTEL POO" />

        <TableView fx:id="tabelaQuartos" layoutX="80.0" layoutY="70.0" prefHeight="320.0" prefWidth="540.0">
            <columns>
                <TableColumn fx:id="colunaNumero" prefWidth="150.0" text="Número" />
                <TableColumn fx:id="colunaTipo" prefWidth="190.0" text="Tipo" />
                <TableColumn fx:id="colunaStatus" prefWidth="200.0" text="Status" />
            </columns>
        </TableView>

        <Button fx:id="btnCriarReserva"
                layoutX="120.0" layoutY="420.0"
                prefWidth="140.0"
                text="Criar Reserva"
                visible="false"
                onAction="#criarReserva" />

        <Button fx:id="btnCheckIn"
                layoutX="280.0" layoutY="420.0"
                prefWidth="140.0"
                text="Fazer Check-in"
                visible="false"
                onAction="#fazerCheckIn" />

        <Button fx:id="btnCheckOut"
                layoutX="440.0" layoutY="420.0"
                prefWidth="140.0"
                text="Fazer Check-out"
                visible="false"
                onAction="#fazerCheckOut" />
    </children>
</AnchorPane>